{
  "name": "@graphprotocol/billing",
  "version": "1.1.0",
  "private": true,
  "description": "Graph Studio Billing Contracts",
  "main": "index.js",
  "scripts": {
    "prepublishOnly": "scripts/prepublish",
    "build": "pnpm build:self",
    "build:self": "SKIP_LOAD=true scripts/build",
    "clean": "rm -rf build/ cache/ dist/ coverage/ reports/",
    "clean:all": "rm -rf node_modules && pnpm clean",
    "compile": "hardhat compile",
    "deploy:all": "scripts/deployAll",
    "test": "pnpm build && pnpm test:self",
    "test:self": "SKIP_LOAD=true hardhat test",
    "test:gas": "RUN_EVM=true REPORT_GAS=true scripts/test",
    "test:coverage": "pnpm build && pnpm test:coverage:self",
    "test:coverage:self": "SKIP_LOAD=true scripts/coverage",
    "security": "scripts/security",
    "flatten": "scripts/flatten",
    "typechain": "hardhat typechain",
    "verify": "hardhat verify"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@graphprotocol/common-ts": "^1.8.6",
    "@nomicfoundation/hardhat-chai-matchers": "^1.0.3",
    "@nomiclabs/hardhat-ethers": "*",
    "@nomiclabs/hardhat-etherscan": "^3.1.2",
    "@openzeppelin/contracts": "4.7.3",
    "@typechain/ethers-v5": "^10.1.0",
    "@typechain/hardhat": "^6.1.2",
    "@types/mocha": "^9.1.1",
    "@types/node": "^18.0.5",
    "arb-bridge-peripherals": "1.0.11",
    "axios": "^0.21.1",
    "chai": "^4.2.0",
    "consola": "^2.15.3",
    "dotenv": "^10.0.0",
    "ethers": "^5.6.0",
    "hardhat": "^2.10.1",
    "hardhat-abi-exporter": "^2.2.1",
    "inquirer": "^8.1.2",
    "solidity-coverage": "^0.8.2",
    "ts-node": "^10.0.0",
    "typechain": "^8.1.0",
    "typescript": "^4.0.2"
  },
  "dependencies": {}
}
